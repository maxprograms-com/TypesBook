{
  "name": "typesbook",
  "version": "1.3.0",
  "description": "DocBook files merger", "keywords": [
    "docbook",
    "merger",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "typesbook": "dist/cli.js"
  },
  "author": {
    "name": "Rodolfo M. Raya",
    "url": "https://maxprograms.com",
    "email": "rmraya@maxprograms.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxprograms-com/TypesBook.git"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy-catalog": "node -e \"require('node:fs').cpSync('catalog', 'dist/catalog', { recursive: true })\"",
    "make-executable": "node -e \"const fs=require('node:fs'); const p='dist/cli.js'; if (fs.existsSync(p)) { try { fs.chmodSync(p, 0o755); } catch {} }\"",
    "build": "npm run clean && tsc && npm run copy-catalog && npm run make-executable",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typesxml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
